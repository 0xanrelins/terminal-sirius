DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius

# Likidasyon: tek yazıcı = Nautilus LiquidationUiBridge → UI + DB
PERSIST_LIQUIDATION_EVENTS_TO_DB=1

# Parquet catalog — native StreamingConfig on TradingNode (RELOAD=0)
CATALOG_STREAMING_ENABLED=true
# CATALOG_PATH=backend/catalog  (default: backend/catalog/)
# CATALOG_USE_ARCHIVE=1       → read-only archive snapshot instead

# ── Polymarket (data + idle execution client for future strategies) ─────────
# POLYMARKET_DATA_ENABLED=true  (false = no Polymarket ticker stream)
# POLYMARKET_EXEC_ENABLED=true  (registers ExecutionClient when creds set; no strategies yet)
# Legacy alias: LIVE_ENABLED maps to POLYMARKET_EXEC_ENABLED if unset
# POLYMARKET_EXEC_ENABLED=false
# POLYMARKET_MAX_RETRIES=3  POLYMARKET_RETRY_DELAY_SEC=1.0
# POLYMARKET_OPEN_CHECK_INTERVAL_SEC=30
# Wallet private key (Polygon) — yeterli; API creds otomatik türetilir
POLYMARKET_PRIVATE_KEY=
# Opsiyonel: elle set etmek istersen (derive ile aynı değerler)
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# Deposit / proxy funder (Polymarket UI deposit address; often same as MetaMask)
# POLYMARKET_FUNDER_ADDRESS=0x...
# 0=EOA  1=POLY_PROXY  2=GNOSIS_SAFE  3=POLY_1271 deposit flow
# POLYMARKET_SIGNATURE_TYPE=2

# ── Paper trade (TerminalSiriusStrategy + Sandbox) ───────────────────────────
# STRATEGY_ENABLED=true
# STRATEGY_PAPER_TRADE=true          # default true when strategy on
# STRATEGY_STARTING_BALANCE="10_000 USDC"
# STRATEGY_TRADE_SIZE=10
# STRATEGY_RECALC_INTERVAL_SEC=1
# STRATEGY_BAR_PERIOD=900            # warm-up ≈ this many seconds
# STRATEGY_ATR_MULTIPLIER=1.5        # lower (e.g. 1.0) = easier zone entry
# STRATEGY_SLOPE_RANGE_THRESHOLD=0.05  # higher (e.g. 0.09) = more "range" entries
# LIQ_THRESHOLD_BTC=500000           # $ rolling 900s — tune daily / backtest
# LIQ_THRESHOLD_ETH=200000
# LIQ_THRESHOLD_SOL=100000
# LIQ_THRESHOLD_XRP=50000
# LIQ_THRESHOLD_DOGE=25000
# Smoke-test example (10× lower liq + 1.0 / 0.09): see repo .env when active
# NAUTILUS_LOG_LEVEL=INFO            # see PAPER fill/position in uvicorn.log
# Checklist: docs/paper-trade.md
