DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius

# Ham likidasyon arşivi — scripts/record_binance_liquidations.py (uvicorn yazmaz)
# LIQ_RECORDER_OUTPUT_DIR=./data/liq_raw
# LIQ_RECORDER_SHARD=daily
# LIQ_RECORDER_POSTGRES=1

# Backend ham event yazımı (varsayılan kapalı; recorder/import üstlensin)
PERSIST_LIQUIDATION_EVENTS_TO_DB=0

# ── Live trading (Polymarket CLOB) ───────────────────────────────────────────
# LIVE_ENABLED=false → sinyal loglanır, emir gönderilmez
LIVE_ENABLED=true
LIVE_ASSETS=SOL,DOGE
LIVE_THRESHOLDS_JSON={"SOL":200000,"DOGE":200000}
LIVE_MIN_USD=1.0
LIVE_MIN_SHARES=5
# Wallet private key (Polygon) — yeterli; API creds otomatik türetilir
POLYMARKET_PRIVATE_KEY=
# Opsiyonel: elle set etmek istersen (derive ile aynı değerler)
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# Deposit / proxy funder (Polymarket UI deposit address; often same as MetaMask)
# POLYMARKET_FUNDER_ADDRESS=0x...
# 0=EOA  1=POLY_PROXY  2=GNOSIS_SAFE  3=POLY_1271 deposit flow
# POLYMARKET_SIGNATURE_TYPE=2
